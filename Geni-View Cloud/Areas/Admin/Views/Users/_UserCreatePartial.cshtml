@model GeniView.Cloud.Models.UserViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    IEnumerable<SelectListItem> gvTimeZones = ViewBag.TimeZones as IEnumerable<SelectListItem>;
    if (gvTimeZones == null && ViewBag.TimeZones != null)
    {
        gvTimeZones = new SelectList((System.Collections.IEnumerable)ViewBag.TimeZones, "ID", "DisplayText", Model?.User?.TimeZoneId);
    }
    gvTimeZones ??= Array.Empty<SelectListItem>();
}

<div>@Html.ValidationMessage("DbFail", new { @class = "text-danger" })</div>
<div>@Html.ValidationMessage("EmailError", new { @class = "text-danger" })</div>
<div>@Html.ValidationMessage("GroupIDError", new { @class = "text-danger" })</div>

<div class="admin-page-header">
    <span class="admin-page-title">Create New Account</span>
</div>

@using (Html.BeginForm("CreateNewAccount", "Users", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="admin-form-card">

        <div class="admin-field-group">
            <label for="RoleName" class="admin-field-label">Role</label>
            @Html.DropDownListFor(m => m.RoleName,
                new SelectList(new[]
                {
                    "Application Admin",
                    "Application User",
                    "Community Admin",
                    "Community Group Admin",
                    "Community User"
                }),
                "-- Select Role --",
                new { @class = "admin-field-input", id = "RoleName" })
            @Html.ValidationMessageFor(m => m.RoleName, "", new { @class = "text-danger" })
        </div>

        <div class="admin-field-group">
            <label for="User_FullName" class="admin-field-label">Full Name</label>
            @Html.TextBoxFor(m => m.User.FullName, new { @class = "admin-field-input", id = "User_FullName" })
        </div>

        <div class="admin-field-group">
            <label for="User_Email" class="admin-field-label">Email</label>
            @Html.TextBoxFor(m => m.User.Email, new { @class = "admin-field-input", id = "User_Email" })
            @Html.ValidationMessageFor(m => m.User.Email, "", new { @class = "text-danger" })
        </div>

        <div class="admin-field-group">
            <label for="User_CommunityID" class="admin-field-label">Community</label>
            @Html.DropDownListFor(m => m.User.CommunityID,
                ViewBag.Communities as SelectList,
                "-- Select Community --",
                new { @class = "admin-field-input", id = "User_CommunityID" })
        </div>

        <div class="admin-field-group">
            <label for="User_GroupID" class="admin-field-label">Group</label>
            @Html.DropDownListFor(m => m.User.GroupID,
                ViewBag.Groups as SelectList,
                "-- None --",
                new { @class = "admin-field-input", id = "User_GroupID" })
        </div>

        <div class="admin-field-group">
            <label for="User_TimeZoneId" class="admin-field-label">Time Zone</label>
            @Html.DropDownListFor(m => m.User.TimeZoneId,
                gvTimeZones,
                "-- Select Time Zone --",
                new { @class = "admin-field-input", id = "User_TimeZoneId" })
        </div>

        <div class="admin-field-group admin-field-group--check">
            <label class="admin-field-label">Email Notifications</label>
            <label class="admin-toggle">
                @Html.CheckBoxFor(m => m.User.IsNotificationEnable, new { id = "User_IsNotificationEnable" })
                <span class="admin-toggle-slider"></span>
            </label>
        </div>

        <div class="admin-field-group admin-field-group--check">
            <label class="admin-field-label">Activate by Email</label>
            <label class="admin-toggle">
                @Html.CheckBoxFor(m => m.ActivateUserByEmail, new { id = "ActivateUserByEmail" })
                <span class="admin-toggle-slider"></span>
            </label>
        </div>

        <div class="admin-field-group" id="PasswordHideDiv">
            <label for="Password" class="admin-field-label">Password</label>
            @Html.PasswordFor(m => m.Password, new { @class = "admin-field-input", id = "Password", placeholder = "Leave blank to auto-generate" })
        </div>

        <div class="admin-form-actions">
            <a href="@Url.Action("Index")" class="btn-admin-back">Cancel</a>
            <button type="submit" class="btn-admin-primary">Create Account</button>
        </div>
    </div>
}
