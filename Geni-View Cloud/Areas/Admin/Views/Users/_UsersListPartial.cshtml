@model IEnumerable<GeniView.Cloud.Models.UserViewModel>

<div>@Html.ValidationMessage("DbFail", new { @class = "text-danger" })</div>

<div class="admin-page-header">
    <span class="admin-page-title">Users</span>
    <div class="admin-page-header-actions">
        <div class="admin-search-wrap">
            <i class="fa fa-search admin-search-icon"></i>
            <input type="text" id="userSearch" class="admin-search-input" placeholder="Search by name or email..." />
        </div>
        <a href="@Url.Action("CreateNewAccount")" class="btn-admin-add">+ Add new</a>
    </div>
</div>

<div class="admin-table-card">
    <table id="UsersTable" class="admin-table" style="width:100%">
        <thead>
            <tr>
                <th></th>
                <th>Full Name</th>
                <th>E-Mail</th>
                <th>Locked</th>
                <th>Email Notifications</th>
                <th>Group</th>
                <th>Community</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr data-timezone="@(item.User.TimeZoneId ?? "--")" data-role="@(item.RoleName ?? "--")">
                        <td class="user-expand-cell">
                            <span class="user-expand-btn" title="Show details">&#8250;</span>
                        </td>
                        <td>
                            @item.User.FullName
                            @if (!item.User.EmailConfirmed)
                            {
                                <br /><span class="admin-status-inactive" style="font-size:11px;">Unconfirmed</span>
                            }
                        </td>
                        <td>@item.User.Email</td>
                        <td>
                            @if (item.isUserLocked)
                            {
                                <span class="admin-status-inactive">Yes</span>
                            }
                            else
                            {
                                <span class="admin-status-active">No</span>
                            }
                        </td>
                        <td>
                            @if (item.User.IsNotificationEnable)
                            {
                                <span class="admin-status-active"><i class="fa fa-check-square"></i> Yes</span>
                            }
                            else
                            {
                                <span class="admin-status-inactive"><i class="fa fa-square"></i> No</span>
                            }
                        </td>
                        <td>@(string.IsNullOrEmpty(item.GroupName) ? "--" : item.GroupName)</td>
                        <td>@(string.IsNullOrEmpty(item.CommunityName) ? "--" : item.CommunityName)</td>
                        <td>
                            <div class="action-buttons" style="display:flex;gap:6px;">
                                <a href="@Url.Action("Edit", new { id = item.User.Id })" class="btn-admin-show">Edit</a>
                                <a href="@Url.Action("Delete", new { id = item.User.Id })" class="btn-admin-show" style="color:#dc2626;border-color:#fecaca;background:#fef2f2;">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination-container">
        <div class="pagination-info">Showing 0 to 0 of 0 entries</div>
        <div class="pagination-controls">
            <button class="pagination-btn prev" disabled>
                <i class="fa fa-chevron-left"></i> Previous
            </button>
            <div class="page-numbers"></div>
            <button class="pagination-btn next">
                Next <i class="fa fa-chevron-right"></i>
            </button>
        </div>
    </div>
</div>
