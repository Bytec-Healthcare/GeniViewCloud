@model GeniView.Data.Web.Community

<div>@Html.ValidationMessage("DbFail", new { @class = "text-danger" })</div>

@using (Html.BeginForm("Edit", "Communities", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ID)
    @Html.HiddenFor(m => m.CommunityID)
    @Html.HiddenFor(m => m.CreateDate)

    <div class="admin-page-header">
        <span class="admin-page-title">Editing Community : @Model.Name</span>
    </div>

    <div class="admin-form-card">

        <div class="admin-field-group">
            <label class="admin-field-label">Community Name</label>
            @Html.TextBoxFor(m => m.Name, new { @class = "admin-field-input", placeholder = "Enter here..." })
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
        </div>

        <div class="admin-field-group">
            <label class="admin-field-label">Description</label>
            @Html.TextAreaFor(m => m.Description, new { @class = "admin-field-input admin-field-textarea", placeholder = "Write here..." })
        </div>

        <div class="admin-field-group admin-checkbox-row">
            @Html.CheckBoxFor(m => m.IsActive)
            <label for="IsActive" class="admin-checkbox-label">Active</label>
        </div>

        @* Address fields preserved *@
        @if (Model.Address != null)
        {
            @Html.HiddenFor(m => m.Address.StreetLineOne)
            @Html.HiddenFor(m => m.Address.StreetLineTwo)
            @Html.HiddenFor(m => m.Address.City)
            @Html.HiddenFor(m => m.Address.Region)
            @Html.HiddenFor(m => m.Address.Country)
            @Html.HiddenFor(m => m.Address.PostalCode)
            @Html.HiddenFor(m => m.Address.Phone)
            @Html.HiddenFor(m => m.Address.Email)
            @Html.HiddenFor(m => m.Address.Website)
        }

        <div class="admin-form-actions">
            <a href="@Url.Action("Index")" class="btn-admin-back">Back</a>
            <button type="submit" class="btn-admin-primary">Save</button>
        </div>
    </div>
}
