@model IEnumerable<GeniView.Data.Web.Community>

<div>@Html.ValidationMessage("DbFail", new { @class = "text-danger" })</div>

<div class="admin-page-header">
    <span class="admin-page-title">Communities</span>
    <div class="admin-page-header-actions">
        <div class="admin-search-wrap">
            <i class="fa fa-search admin-search-icon"></i>
            <input type="text" id="communitySearch" class="admin-search-input" placeholder="Search by Community name........" />
        </div>
        <a href="@Url.Action("Create")" class="btn-admin-add">+ Add new</a>
    </div>
</div>

<div class="admin-table-card">
    <table id="CommunitiesTable" class="admin-table" style="width:100%">
        <thead>
            <tr>
                <th>Community Name</th>
                <th>Description</th>
                <th>Address</th>
                <th>Active</th>
                <th>Create Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@(item.Description ?? "--")</td>
                        <td>@(item.Address != null && !string.IsNullOrWhiteSpace(item.Address.City) ? item.Address.City : "--")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="admin-status-active">
                                    <i class="fa fa-check-square"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="admin-status-inactive">
                                    <i class="fa fa-square"></i> Inactive
                                </span>
                            }
                        </td>
                        <td>
                            <i class="fa fa-clock-o admin-date-icon"></i>
                            @item.CreateDate.ToString("yyyy-MM-dd HH:mm:ss")
                        </td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = item.ID })" class="btn-admin-show">Edit</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination-container">
        <div class="pagination-info">Showing 0 to 0 of 0 entries</div>
        <div class="pagination-controls">
            <button class="pagination-btn prev" disabled>
                <i class="fa fa-chevron-left"></i> Previous
            </button>
            <div class="page-numbers"></div>
            <button class="pagination-btn next">
                Next <i class="fa fa-chevron-right"></i>
            </button>
        </div>
    </div>
</div>
