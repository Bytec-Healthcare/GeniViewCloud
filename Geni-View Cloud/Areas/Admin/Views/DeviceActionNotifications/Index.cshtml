@model List<GeniView.Cloud.Models.DeviceActionNotificationViewModel>

@{
    ViewBag.Title = "Device Event Notifications";
}

@section scripts
{
    <script type="text/javascript">
        var oTable;
        $(document).ready(function () {

            oTable = $('#MappingTable').DataTable({
                responsive: { details: false },
                dom: 'tip',
                pageLength: 13,
                columnDefs: [
                    { searchable: false, orderable: false, width: '44px', className: 'all', targets: [0] },
                    { searchable: false, orderable: false, targets: [-1] }
                ]
            });

            $('#notifSearch').on('keyup', function () {
                oTable.search(this.value).draw();
            });

            $('#select-all').on('click', function () {
                var rows = oTable.rows({ 'search': 'applied' }).nodes();
                $('input[type="checkbox"]', rows).prop('checked', this.checked);
            });

            $('#Enable').click(function () {
                var data = oTable.$('input, select').serializeArray();
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("EnableNotifications")',
                    data: data,
                    success: function (result) {
                        window.location.reload();
                    }
                });
            });

            $('#Disable').click(function () {
                var data = oTable.$('input, select').serializeArray();
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DisableNotifications")',
                    data: data,
                    success: function (result) {
                        window.location.reload();
                    }
                });
            });
        });
    </script>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="admin-page-header">
        <span class="admin-page-title">Device Event Notifications</span>
        <div class="admin-page-header-actions">
            <div class="admin-search-wrap">
                <i class="fa fa-search admin-search-icon"></i>
                <input type="text" id="notifSearch" class="admin-search-input" placeholder="Search by name......." />
            </div>
            <input type="button" value="Disable Notifications" id="Disable" class="btn-admin-back" />
            <input type="button" value="Enable Notifications"  id="Enable"  class="btn-admin-primary" />
        </div>
    </div>

    <p id="ErrorMessage" class="text-danger" style="margin:0 0 8px;">@Html.ValidationMessage("DbFail", new { @class = "text-danger" })</p>

    <div class="admin-table-card">
        <table class="admin-table" id="MappingTable" style="width:100%;">
            <thead>
                <tr>
                    <th style="width:44px;">
                        <input value="1" id="select-all" type="checkbox" class="admin-notif-checkbox" />
                    </th>
                    <th>Description</th>
                    <th>Send Notifications</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    for (var i = 0; i < Model.Count(); i++)
                    {
                        <tr>
                            <td>
                                @Html.EditorFor(m => Model[i].IsChecked, new { htmlAttributes = new { @class = "admin-notif-checkbox" } })
                            </td>
                            <td>
                                @Html.DisplayFor(m => Model[i].DeviceEventNotification.Description)
                                @Html.HiddenFor(m => Model[i].DeviceEventNotification.ID)
                            </td>
                            <td>
                                @if (Model[i].DeviceEventNotification.SendNotifications)
                                {
                                    <span class="admin-notif-enabled">Enabled</span>
                                }
                                else
                                {
                                    <span class="admin-notif-disabled">Disabled</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
