@model GeniView.Cloud.Models.AssignRemoveListModel
@{
    ViewBag.Title = "Remove Batteries";
}
@section scripts
{
    <script type="text/javascript">
        var oTable;
        $(document).ready(function () {
            oTable = $('#RemoveTable').DataTable({
                responsive: { details: false },
                dom: 't',
                pageLength: 13,
                columnDefs: [
                    { searchable: false, orderable: false, width: '44px', className: 'all', targets: [0] }
                ],
                drawCallback: function () {
                    updatePagination(this.api());
                }
            });

            $('#select-all').on('click', function () {
                var rows = oTable.rows({ 'search': 'applied' }).nodes();
                $('input[type="checkbox"]', rows).prop('checked', this.checked);
            });

            $('#communitydropdown').change(function () {
                $(this).closest('form').trigger('submit');
            });

            $('#RemoveButton').click(function () {
                var data = oTable.$('input, select').serializeArray();
                var communityID = parseInt($('#communitydropdown').val());
                data.push({ name: 'CommunityID', value: communityID });
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("RemoveBatteries")',
                    data: data,
                    success: function () { window.location.reload(); }
                });
            });

            $('.pagination-btn.prev').on('click', function () {
                if (!$(this).prop('disabled')) oTable.page('previous').draw('page');
            });
            $('.pagination-btn.next').on('click', function () {
                if (!$(this).prop('disabled')) oTable.page('next').draw('page');
            });
            $(document).on('click', '.pagination-btn.page-num', function () {
                oTable.page($(this).data('page')).draw('page');
            });
        });

        function updatePagination(api) {
            var info = api.page.info();
            $('.pagination-info').text(
                'Showing ' + (info.recordsTotal === 0 ? 0 : info.start + 1) +
                ' to ' + info.end + ' of ' + info.recordsTotal + ' entries'
            );
            $('.pagination-btn.prev').prop('disabled', info.page === 0);
            $('.pagination-btn.next').prop('disabled', info.page === info.pages - 1);
            renderPageNumbers(info.page, info.pages);
        }

        function renderPageNumbers(currentPage, totalPages) {
            var container = $('.page-numbers');
            container.empty();
            if (totalPages <= 0) return;
            var max = 4, start = Math.max(0, currentPage - Math.floor(max / 2));
            var end = Math.min(totalPages - 1, start + max - 1);
            if (end - start < max - 1) start = Math.max(0, end - max + 1);
            for (var i = start; i <= end; i++) {
                $('<button>').attr('type', 'button')
                    .addClass('pagination-btn page-num' + (i === currentPage ? ' active' : ''))
                    .attr('data-page', i).text(i + 1).appendTo(container);
            }
        }
    </script>
    <script src="~/js/dropdownfilter.min.js"></script>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @if (Model != null)
    {
        <label id="EditModeCommunityID" hidden="hidden">@Model.CommunityID</label>
    }

    <div class="admin-page-header">
        <span class="admin-page-title">Remove Batteries</span>
        <div class="admin-page-header-actions">
            <select id="communitydropdown" name="CommunityID" class="admin-community-select"></select>
            <input type="button" value="Remove" id="RemoveButton" class="btn-admin-primary" />
        </div>
    </div>

    <p class="text-danger">@Html.ValidationMessage("DbFail", new { @class = "text-danger" })</p>

    <div class="admin-table-card">
        <table class="admin-table" id="RemoveTable" style="width:100%;">
            <thead>
                <tr>
                    <th style="width:44px;"><input value="1" id="select-all" type="checkbox" class="admin-notif-checkbox" /></th>
                    <th>Serial Number</th>
                    <th>Community</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.DeviceList != null)
                {
                    for (var i = 0; i < Model.DeviceList.Count; i++)
                    {
                        <tr>
                            <td>@Html.EditorFor(m => Model.DeviceList[i].IsChecked, new { htmlAttributes = new { @class = "admin-notif-checkbox" } })</td>
                            <td>
                                @Html.DisplayFor(m => Model.DeviceList[i].SerialNumber)
                                @Html.HiddenFor(m => Model.DeviceList[i].BatteryBSN)
                                @Html.HiddenFor(m => Model.DeviceList[i].SerialNumber)
                            </td>
                            <td>@Html.DisplayFor(m => Model.DeviceList[i].CommunityName)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-container">
            <div class="pagination-info">Showing 0 to 0 of 0 entries</div>
            <div class="pagination-controls">
                <button type="button" class="pagination-btn prev" disabled>
                    <i class="fa fa-chevron-left"></i> Previous
                </button>
                <div class="page-numbers"></div>
                <button type="button" class="pagination-btn next">
                    Next <i class="fa fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
}
