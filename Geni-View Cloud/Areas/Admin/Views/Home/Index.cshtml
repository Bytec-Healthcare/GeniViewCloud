@model GeniView.Cloud.Models.AdminDashboardModel
@using GeniView.Cloud.Models;
@{
    ViewBag.Title = "Summary";
}

<div class="admin-stat-row">

    <div class="admin-stat-card">
        <div class="admin-stat-card-header">Communities / Groups</div>
        <div class="admin-stat-card-body">
            <div class="admin-stat-item">
                <span class="admin-stat-number stat-blue">@Model.Communities</span>
                <span class="admin-stat-label">Communities</span>
            </div>
            <div class="admin-stat-divider"></div>
            <div class="admin-stat-item">
                <span class="admin-stat-number stat-blue">@Model.Groups</span>
                <span class="admin-stat-label">Groups</span>
            </div>
        </div>
    </div>

    <div class="admin-stat-card">
        <div class="admin-stat-card-header">Devices</div>
        <div class="admin-stat-card-body">
            <div class="admin-stat-item">
                <span class="admin-stat-number stat-green">@Model.RegDevices</span>
                <span class="admin-stat-label">Assigned</span>
            </div>
            <div class="admin-stat-divider"></div>
            <div class="admin-stat-item">
                <span class="admin-stat-number stat-red">@Model.RemDevices</span>
                <span class="admin-stat-label">Unassigned</span>
            </div>
        </div>
    </div>

    <div class="admin-stat-card">
        <div class="admin-stat-card-header">Batteries</div>
        <div class="admin-stat-card-body">
            <div class="admin-stat-item">
                <span class="admin-stat-number stat-green">@Model.RegBatteries</span>
                <span class="admin-stat-label">Assigned</span>
            </div>
            <div class="admin-stat-divider"></div>
            <div class="admin-stat-item">
                <span class="admin-stat-number stat-red">@Model.RemBatteries</span>
                <span class="admin-stat-label">Unassigned</span>
            </div>
        </div>
    </div>

</div>
