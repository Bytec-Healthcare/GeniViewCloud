@model IEnumerable<GeniView.Data.Web.Group>

<div>@Html.ValidationMessage("DbFail", new { @class = "text-danger" })</div>

<div class="admin-page-header">
    <span class="admin-page-title">Groups</span>
    <div class="admin-page-header-actions">
        <div class="admin-search-wrap">
            <i class="fa fa-search admin-search-icon"></i>
            <input type="text" id="groupSearch" class="admin-search-input" placeholder="Search by Group name..." />
        </div>
        <a href="@Url.Action("Create")" class="btn-admin-add">+ Add new</a>
    </div>
</div>

<div class="admin-table-card">
    <table id="GroupsTable" class="admin-table" style="width:100%">
        <thead>
            <tr>
                <th>Name</th>
                <th>Community</th>
                <th>Parent Group</th>
                <th>Create Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@(item.Community?.Name ?? "--")</td>
                        <td>@(item.ParentGroup?.Name ?? "--")</td>
                        <td>@item.CreateDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @Html.ActionLink("Show", "Edit", new { id = item.ID }, new { @class = "btn-admin-show" })
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination-container">
        <div class="pagination-info">Showing 0 to 0 of 0 entries</div>
        <div class="pagination-controls">
            <button class="pagination-btn prev" disabled>
                <i class="fa fa-chevron-left"></i> Previous
            </button>
            <div class="page-numbers"></div>
            <button class="pagination-btn next">
                Next <i class="fa fa-chevron-right"></i>
            </button>
        </div>
    </div>
</div>
