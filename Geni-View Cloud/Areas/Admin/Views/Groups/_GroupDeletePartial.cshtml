@model GeniView.Data.Web.Group

<div>@Html.ValidationMessage("DbFail", new { @class = "text-danger" })</div>

<div class="admin-page-header">
    <span class="admin-page-title">Delete Group</span>
</div>

<div class="admin-form-card admin-form-card--delete">

    <p style="font-size:15px; color:#374151; margin-bottom:12px;">Are you sure you want to delete ?</p>
    <hr style="border-color:#f3f4f6; margin-bottom:16px;" />
    <p style="font-size:15px; font-weight:600; color:#111827;">Group Name : @Model.Name</p>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="admin-form-actions">
            <a href="@Url.Action("Index")" class="btn-admin-primary">No</a>
            <button type="submit" class="btn-admin-back" style="color:#dc2626; border-color:#fecaca;">Yes, Delete</button>
        </div>
    }
</div>
