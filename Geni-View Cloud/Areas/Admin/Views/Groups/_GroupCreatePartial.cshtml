@model GeniView.Cloud.Models.GroupViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

<div>@Html.ValidationMessage("DbFail", new { @class = "text-danger" })</div>

@using (Html.BeginForm("Create", "Groups", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="admin-page-header">
        <span class="admin-page-title">Add New Group</span>
    </div>

    <div class="admin-form-card">

        <div class="admin-field-group">
            <label class="admin-field-label" for="CommunityID">Community</label>
            @Html.DropDownListFor(m => m.CommunityID,
                ViewBag.Communities as SelectList,
                "-- Select Community --",
                new { @class = "admin-field-input admin-field-select" })
            @Html.ValidationMessageFor(m => m.CommunityID, "", new { @class = "text-danger" })
        </div>

        <div class="admin-field-group">
            <label class="admin-field-label" for="ParentGroupID">Parent Group</label>
            @Html.DropDownListFor(m => m.ParentGroupID,
                ViewBag.Groups as SelectList,
                "-- None (Top Level) --",
                new { @class = "admin-field-input admin-field-select" })
        </div>

        <div class="admin-field-group">
            <label class="admin-field-label" for="Group_Name">Group Name</label>
            @Html.TextBoxFor(m => m.Group.Name, new { @class = "admin-field-input", placeholder = "Enter here..." })
            @Html.ValidationMessageFor(m => m.Group.Name, "", new { @class = "text-danger" })
        </div>

        <div class="admin-field-group">
            <label class="admin-field-label" for="Group_Description">Description</label>
            @Html.TextAreaFor(m => m.Group.Description, new { @class = "admin-field-input admin-field-textarea", placeholder = "Write here..." })
        </div>

        <div class="admin-form-actions">
            <a href="@Url.Action("Index")" class="btn-admin-back">Cancel</a>
            <button type="submit" class="btn-admin-primary">Save</button>
        </div>
    </div>
}
