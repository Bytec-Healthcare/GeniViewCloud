@model List<GeniView.Cloud.Models.ActivateDeactivatedModel>
@{
    ViewBag.Title = "Deactivated Devices";
}
@section scripts
{
    <script type="text/javascript">
        var oTable;
        $(document).ready(function () {
            oTable = $('#DeactivateTable').DataTable({
                responsive: { details: false },
                dom: 'tip',
                pageLength: 13,
                columnDefs: [
                    { searchable: false, orderable: false, width: '44px', className: 'all', targets: [0] }
                ]
            });

            $('#select-all').on('click', function () {
                var rows = oTable.rows({ 'search': 'applied' }).nodes();
                $('input[type="checkbox"]', rows).prop('checked', this.checked);
            });

            $('#ActivateButton').click(function () {
                var data = oTable.$('input, select').serializeArray();
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Activate")',
                    data: data,
                    success: function () { window.location.reload(); }
                });
            });
        });
    </script>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="admin-page-header">
        <span class="admin-page-title">Deactivated Devices</span>
        <div class="admin-page-header-actions">
            <input type="button" value="Activate" id="ActivateButton" class="btn-admin-primary" />
        </div>
    </div>

    <p class="text-danger">@Html.ValidationMessage("DbFail", new { @class = "text-danger" })</p>

    <div class="admin-table-card">
        <table class="admin-table" id="DeactivateTable" style="width:100%;">
            <thead>
                <tr>
                    <th style="width:44px;"><input value="1" id="select-all" type="checkbox" class="admin-notif-checkbox" /></th>
                    <th>Serial Number</th>
                    <th>Community</th>
                    <th>Group</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    for (var i = 0; i < Model.Count(); i++)
                    {
                        <tr>
                            <td>@Html.EditorFor(m => Model[i].IsChecked, new { htmlAttributes = new { @class = "admin-notif-checkbox" } })</td>
                            <td>
                                @Html.DisplayFor(m => Model[i].SerialNumber)
                                @Html.HiddenFor(m => Model[i].SerialNumber)
                            </td>
                            <td>@Html.DisplayFor(m => Model[i].CommunityName)</td>
                            <td>@Html.DisplayFor(m => Model[i].GroupName)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
