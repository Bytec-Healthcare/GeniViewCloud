@model GeniView.Cloud.Models.AssignRemoveListModel
@{
    ViewBag.Title = "Remove Devices";
}
@section scripts
{
    <script type="text/javascript">
        var oTable;
        $(document).ready(function () {
            oTable = $('#RemoveTable').DataTable({
                responsive: { details: false },
                dom: 'tip',
                pageLength: 13,
                columnDefs: [
                    { searchable: false, orderable: false, width: '44px', className: 'all', targets: [0] }
                ]
            });

            $('#select-all').on('click', function () {
                var rows = oTable.rows({ 'search': 'applied' }).nodes();
                $('input[type="checkbox"]', rows).prop('checked', this.checked);
            });

            $('#communitydropdown').change(function () {
                $(this).closest('form').trigger('submit');
            });

            $('#RemoveButton').click(function () {
                var data = oTable.$('input, select').serializeArray();
                var communityID = parseInt($('#communitydropdown').val());
                data.push({ name: 'CommunityID', value: communityID });
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("RemoveDevice")',
                    data: data,
                    success: function () { window.location.reload(); }
                });
            });
        });
    </script>
    <script src="~/js/dropdownfilter.min.js"></script>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @if (Model != null)
    {
        <label id="EditModeCommunityID" hidden="hidden">@Model.CommunityID</label>
    }

    <div class="admin-page-header">
        <span class="admin-page-title">Remove Devices</span>
        <div class="admin-page-header-actions">
            <select id="communitydropdown" name="CommunityID" class="admin-community-select"></select>
            <input type="button" value="Remove" id="RemoveButton" class="btn-admin-primary" />
        </div>
    </div>

    <p class="text-danger">@Html.ValidationMessage("DbFail", new { @class = "text-danger" })</p>

    <div class="admin-table-card">
        <table class="admin-table" id="RemoveTable" style="width:100%;">
            <thead>
                <tr>
                    <th style="width:44px;"><input value="1" id="select-all" type="checkbox" class="admin-notif-checkbox" /></th>
                    <th>Serial Number</th>
                    <th>Community</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.DeviceList != null)
                {
                    for (var i = 0; i < Model.DeviceList.Count; i++)
                    {
                        <tr>
                            <td>@Html.EditorFor(m => Model.DeviceList[i].IsChecked, new { htmlAttributes = new { @class = "admin-notif-checkbox" } })</td>
                            <td>
                                @Html.DisplayFor(m => Model.DeviceList[i].SerialNumber)
                                @Html.HiddenFor(m => Model.DeviceList[i].SerialNumber)
                            </td>
                            <td>@Html.DisplayFor(m => Model.DeviceList[i].CommunityName)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
