@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<div class="text-center logo-container">
    <a href="@Url.Action("Index","Home")">
        <img class="img-rounded logo-img" src="~/images/gvc_logo.svg" id="logoImg" alt="GeniView Logo" />
    </a>
</div>
<hr class="admin-sidebar-divider" />
<ul class="sidebar-nav gv-sidebar-nav admin-sidebar-nav" aria-label="Admin Navigation">
    <li>
        <a href="@Url.Action("Index","Dashboard", new { area = "" })">
            <span class="fa-stack fa-lg"><i class="fa fa-arrow-left fa-stack-1x"></i></span>
            <span class="gv-nav-text">Back to Home</span>
        </a>
    </li>
    <li class="@(ctrl == "Communities" ? "active" : "")">
        <a href="@Url.Action("Index","Communities")">
            <span class="fa-stack fa-lg"><i class="fa fa-flag fa-stack-1x"></i></span>
            <span class="gv-nav-text">Communities</span>
        </a>
    </li>
    <li class="@(ctrl == "Groups" ? "active" : "")">
        <a href="@Url.Action("Index","Groups")">
            <span class="fa-stack fa-lg"><i class="fa fa-users fa-stack-1x"></i></span>
            <span class="gv-nav-text">Groups</span>
        </a>
    </li>
    <li class="@(ctrl == "Users" ? "active" : "")">
        <a href="@Url.Action("Index","Users")">
            <span class="fa-stack fa-lg"><i class="fa fa-user fa-stack-1x"></i></span>
            <span class="gv-nav-text">Users</span>
        </a>
    </li>
    <li style="display:none;"><a href="@Url.Action("Index","UserActivityHistory")"><span class="fa-stack fa-lg"><i class="fas fa-history fa-stack-1x"></i></span><span class="gv-nav-text">Activity History</span></a></li>
    <li style="display:none;"><a href="@Url.Action("Index","ApplicationUpdates")"><span class="fa-stack fa-lg"><i class="fa fa-sync fa-stack-1x"></i></span><span class="gv-nav-text">Application Updates</span></a></li>
    <li style="display:none;"><a href="@Url.Action("Index","ApplicationLogs")"><span class="fa-stack fa-lg"><i class="far fa-file-alt fa-stack-1x"></i></span><span class="gv-nav-text">Application Logs</span></a></li>

    <li class="@(ctrl == "Device" ? "active" : "")">
        <a href="#" data-toggle="collapse" data-target="#DeviceMenu" class="admin-menu-toggle">
            <span class="fa-stack fa-lg"><i class="far fa-hdd fa-stack-1x"></i></span>
            <span class="gv-nav-text admin-menu-text">Device Settings</span>
            <span class="fa-stack fa-lg admin-menu-chevron"><i class="fa fa-chevron-down fa-stack-1x"></i></span>
        </a>
        <ul class="sidebar-nav gv-sidebar-nav admin-subnav collapse in" id="DeviceMenu">
            <li><a href="@Url.Action("Assign","Device")"><span class="fa-stack fa-lg"><i class="fa fa-plus fa-stack-1x"></i></span><span class="gv-nav-text">Assign to Community</span></a></li>
            <li><a href="@Url.Action("Remove","Device")"><span class="fa-stack fa-lg"><i class="fa fa-trash fa-stack-1x"></i></span><span class="gv-nav-text">Remove from Community</span></a></li>
            <li><a href="@Url.Action("ActiveDevices","Device")"><span class="fa-stack fa-lg"><i class="fa fa-eye fa-stack-1x"></i></span><span class="gv-nav-text">Active Devices</span></a></li>
            <li><a href="@Url.Action("DeactivatedDevices","Device")"><span class="fa-stack fa-lg"><i class="fa fa-eye-slash fa-stack-1x"></i></span><span class="gv-nav-text">Deactivated Devices</span></a></li>
        </ul>
    </li>

    <li class="@(ctrl == "Battery" ? "active" : "")">
        <a href="#" data-toggle="collapse" data-target="#BatteryMenu" class="admin-menu-toggle">
            <span class="fa-stack fa-lg"><i class="fa fa-battery-full fa-stack-1x"></i></span>
            <span class="gv-nav-text admin-menu-text">Battery Settings</span>
            <span class="fa-stack fa-lg admin-menu-chevron"><i class="fa fa-chevron-down fa-stack-1x"></i></span>
        </a>
        <ul class="sidebar-nav gv-sidebar-nav admin-subnav collapse in" id="BatteryMenu">
            <li><a href="@Url.Action("Assign","Battery")"><span class="fa-stack fa-lg"><i class="fa fa-plus fa-stack-1x"></i></span><span class="gv-nav-text">Assign to Community</span></a></li>
            <li><a href="@Url.Action("Remove","Battery")"><span class="fa-stack fa-lg"><i class="fa fa-trash fa-stack-1x"></i></span><span class="gv-nav-text">Remove from Community</span></a></li>
            <li><a href="@Url.Action("ActiveBatteries","Battery")"><span class="fa-stack fa-lg"><i class="fa fa-eye fa-stack-1x"></i></span><span class="gv-nav-text">Active Batteries</span></a></li>
            <li><a href="@Url.Action("DeactivatedBatteries","Battery")"><span class="fa-stack fa-lg"><i class="fa fa-eye-slash fa-stack-1x"></i></span><span class="gv-nav-text">Deactivated Batteries</span></a></li>
        </ul>
    </li>

    <li class="@(ctrl == "GeneralSettings" || ctrl == "MailSettings" || ctrl == "DeviceActionNotifications" ? "active" : "")">
        <a href="#" data-toggle="collapse" data-target="#GlobalMenu" class="admin-menu-toggle">
            <span class="fa-stack fa-lg"><i class="fa fa-globe fa-stack-1x"></i></span>
            <span class="gv-nav-text admin-menu-text">Global Configuration</span>
            <span class="fa-stack fa-lg admin-menu-chevron"><i class="fa fa-chevron-down fa-stack-1x"></i></span>
        </a>
        <ul class="sidebar-nav gv-sidebar-nav admin-subnav collapse in" id="GlobalMenu">
            <li class="@(ctrl == "GeneralSettings" ? "active" : "")"><a href="@Url.Action("Index","GeneralSettings")"><span class="fa-stack fa-lg"><i class="fa fa-cog fa-stack-1x"></i></span><span class="gv-nav-text">General Settings</span></a></li>
            <li style="display:none;"><a href="@Url.Action("Index","MailSettings")"><span class="fa-stack fa-lg"><i class="fa fa-envelope fa-stack-1x"></i></span><span class="gv-nav-text">Mail Settings</span></a></li>
            <li class="@(ctrl == "DeviceActionNotifications" ? "active" : "")"><a href="@Url.Action("Index","DeviceActionNotifications")"><span class="fa-stack fa-lg"><i class="fa fa-reply fa-stack-1x"></i></span><span class="gv-nav-text">Device Event Notifications</span></a></li>
        </ul>
    </li>

    <li style="display:none;"><a href="@Url.Action("About","Home")"><span class="fa-stack fa-lg"><i class="fa fa-exclamation fa-stack-1x"></i></span><span class="gv-nav-text">About</span></a></li>
</ul>
