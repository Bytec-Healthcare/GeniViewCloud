@model GeniView.Cloud.Models.GlobalSettingModel
@{
    ViewBag.Title = "General Settings";
}
@section scripts
{
    <script>
        $(document).ready(function () {
            $('.alertColor').colorpicker();
            $('.successColor').colorpicker();
            $('.warningColor').colorpicker();
        });

        var sm = '@(TempData["Success"])';
        alertify.set('notifier', 'position', 'bottom-right');
        if (sm) {
            alertify.success(sm);
        }
    </script>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="admin-page-header">
        <span class="admin-page-title">General Settings</span>
        <div class="admin-page-header-actions">
            <button type="submit" class="btn-admin-primary">Apply Changes</button>
        </div>
    </div>

    <div class="admin-settings-grid">

        <div class="admin-settings-card">
            <div class="admin-settings-card-header">Time Range Settings</div>
            <div class="admin-settings-card-body">
                <div class="admin-field-group">
                    <label class="admin-field-label">Online Time, Minutes</label>
                    @Html.EditorFor(m => m.OnlineRangeInMinutes, new { htmlAttributes = new { @class = "admin-field-input" } })
                </div>
                <div class="admin-field-group">
                    <label class="admin-field-label">Office Time, Days</label>
                    @Html.EditorFor(m => m.OfflineRangeInDays, new { htmlAttributes = new { @class = "admin-field-input" } })
                </div>
            </div>
        </div>

        <div class="admin-settings-card">
            <div class="admin-settings-card-header">Temperature Settings</div>
            <div class="admin-settings-card-body">
                <div class="admin-field-group">
                    <label class="admin-field-label">Normal &lt;</label>
                    @Html.EditorFor(m => m.SuccessTemperature, new { htmlAttributes = new { @class = "admin-field-input" } })
                </div>
                <div class="admin-field-group">
                    <label class="admin-field-label">Alert &gt;</label>
                    @Html.EditorFor(m => m.AlertTemperature, new { htmlAttributes = new { @class = "admin-field-input" } })
                </div>
            </div>
        </div>

        <div class="admin-settings-card">
            <div class="admin-settings-card-header">Charging Level Settings</div>
            <div class="admin-settings-card-body">
                <div class="admin-field-group">
                    <label class="admin-field-label">Normal Level &gt;</label>
                    @Html.EditorFor(m => m.SuccessChargingLVL, new { htmlAttributes = new { @class = "admin-field-input" } })
                </div>
                <div class="admin-field-group">
                    <label class="admin-field-label">Alert Level &lt;</label>
                    @Html.EditorFor(m => m.AlertChargingLVL, new { htmlAttributes = new { @class = "admin-field-input" } })
                </div>
                <div class="admin-field-group">
                    <label class="admin-field-label">Ready to Use &gt;</label>
                    @Html.EditorFor(m => m.IsStateOfChargeReadyToUse, new { htmlAttributes = new { @class = "admin-field-input" } })
                </div>
            </div>
        </div>

        <div class="admin-settings-card">
            <div class="admin-settings-card-header">Color Settings</div>
            <div class="admin-settings-card-body">
                <div class="admin-field-group">
                    <label class="admin-field-label">Normal</label>
                    <div class="input-group successColor admin-color-wrap">
                        <input type="text" value="@Model.SuccessColor" id="SuccessColor" name="SuccessColor" class="admin-field-input" />
                        <span class="input-group-addon admin-color-swatch"><i></i></span>
                    </div>
                </div>
                <div class="admin-field-group">
                    <label class="admin-field-label">Warning</label>
                    <div class="input-group warningColor admin-color-wrap">
                        <input type="text" value="@Model.WarningColor" id="WarningColor" name="WarningColor" class="admin-field-input" />
                        <span class="input-group-addon admin-color-swatch"><i></i></span>
                    </div>
                </div>
                <div class="admin-field-group">
                    <label class="admin-field-label">Alert</label>
                    <div class="input-group alertColor admin-color-wrap">
                        <input type="text" value="@Model.AlertColor" id="AlertColor" name="AlertColor" class="admin-field-input" />
                        <span class="input-group-addon admin-color-swatch"><i></i></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-settings-card">
            <div class="admin-settings-card-header">Static Variables</div>
            <div class="admin-settings-card-body">
                <div class="admin-field-group">
                    <label class="admin-field-label">Normal Voltage</label>
                    @Html.EditorFor(m => m.NominalVoltage, new { htmlAttributes = new { @class = "admin-field-input" } })
                </div>
            </div>
        </div>

        <div class="admin-settings-card">
            <div class="admin-settings-card-header">Bing Map Settings</div>
            <div class="admin-settings-card-body">
                <div class="admin-field-group">
                    <label class="admin-field-label">Key</label>
                    @Html.EditorFor(m => m.BingMapKey, new { htmlAttributes = new { @class = "admin-field-input" } })
                </div>
            </div>
        </div>

        <div class="admin-settings-card">
            <div class="admin-settings-card-header">Email Notification Settings</div>
            <div class="admin-settings-card-body">
                <div class="admin-field-group">
                    <label class="admin-field-label">Send Intervals, Seconds</label>
                    @Html.EditorFor(m => m.NotificationDelayTimeInSeconds, new { htmlAttributes = new { @class = "admin-field-input" } })
                </div>
                <div class="admin-field-group">
                    <label class="admin-field-label">Relevant Time, Minutes</label>
                    @Html.EditorFor(m => m.NotificationToleranceInMinutes, new { htmlAttributes = new { @class = "admin-field-input" } })
                </div>
            </div>
        </div>

        <div class="admin-settings-card">
            <div class="admin-settings-card-header">User Settings</div>
            <div class="admin-settings-card-body">
                <div class="admin-field-group">
                    <label class="admin-field-label">User Lockout, Minutes</label>
                    @Html.EditorFor(m => m.UserLockoutTimeInMinutes, new { htmlAttributes = new { @class = "admin-field-input" } })
                </div>
            </div>
        </div>

    </div>
}
