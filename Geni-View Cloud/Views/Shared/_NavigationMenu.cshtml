<div class="global-nav">
    <div class="global-nav__header">
        <button type="button"
                class="gv-mobile-sidebar-toggle"
                id="gv-mobile-sidebar-toggle"
                aria-label="Toggle sidebar menu"
                title="Menu">
            <i class="fa fa-bars" aria-hidden="true"></i>
        </button>
        <div class="global-nav__section-title">
            @(ViewBag.Title ?? "Batteries")
        </div>

        <div class="global-nav__filters-container">
            @if (ViewBag.ShowCommunityAndGroupFilter != null && ViewBag.ShowCommunityAndGroupFilter)
            {
                @await Html.PartialAsync("_MainFilterPartial")
            }
            @if (ViewBag.ShowCommandFilter != null && (bool)ViewBag.ShowCommandFilter)
            {
                @await Html.PartialAsync("_CommandFilterPartial")
            }
        </div>

        <div class="global-nav__user">
            @await Html.PartialAsync("_LoginPartial")
        </div>
    </div>
</div>
