@model GeniView.Data.Web.Community
<div class="contact-info-block">
    <address class="contact-address">
        <div>@Model.Address.StreetLineOne</div>
        <div>@Model.Address.StreetLineTwo</div>
        <div>@Model.Address.City, @Model.Address.Region</div>
        <div>@Model.Address.Country</div>
        @if (!string.IsNullOrWhiteSpace(Model.Address.PostalCode))
        {
            <div>@Model.Address.PostalCode</div>
        }
    </address>

    <div class="contact-detail-row">
        <span class="contact-detail-label">Phone:</span>
        <span class="contact-detail-icon">
            <i class="fa fa-phone" aria-hidden="true"></i>
        </span>
        <span class="contact-detail-value">@Model.Address.Phone</span>
    </div>

    <div class="contact-detail-row">
        <span class="contact-detail-label">Fax:</span>
        <span class="contact-detail-icon">
            <i class="fa fa-fax" aria-hidden="true"></i>
        </span>
        <span class="contact-detail-value">@Model.Address.Fax</span>
    </div>

    <div class="contact-detail-row">
        <span class="contact-detail-label">Email:</span>
        <span class="contact-detail-icon">
            <i class="fa fa-envelope" aria-hidden="true"></i>
        </span>
        <span class="contact-detail-value">
            <a href="mailto:@Model.Address.Email">@Model.Address.Email</a>
        </span>
    </div>

    <div class="contact-detail-row">
        <span class="contact-detail-label">Web:</span>
        <span class="contact-detail-icon">
            <i class="fa fa-globe" aria-hidden="true"></i>
        </span>
        <span class="contact-detail-value">
            <a href="http://@Model.Address.Website" target="_blank">@Model.Address.Website</a>
        </span>
    </div>
</div>
