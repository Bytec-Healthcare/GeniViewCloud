@model GeniView.Cloud.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot Password";
}

<style>
    /* Forgot Password specific styles */
    .gv-fp-icon-wrap {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    /* Icon is the full SVG (blue box + key already inside it) — no extra wrapper */
    .gv-fp-icon-wrap img {
        width: 64px;
        height: 64px;
    }

    .gv-fp-title {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
        text-align: center;
        margin-bottom: 8px;
    }

    .gv-fp-subtitle {
        font-size: 15px;
        color: #6b7280;
        text-align: center;
        margin-bottom: 28px;
    }

    .gv-form-group {
        margin-bottom: 20px;
    }

    /* Larger label for Email Address as per UX */
    .gv-fp-email-label {
        display: block;
        font-size: 18px;
        font-weight: 600;
        color: #1a1a2e;
        margin-bottom: 8px;
    }

    .gv-back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: #374151;
        text-decoration: none;
        font-weight: 500;
        margin-top: 16px;
    }

    .gv-back-link:hover {
        color: #3e4cc1;
        text-decoration: none;
    }

    /* UX-style inline field error: circle-exclamation icon + red text */
    .gv-fp-field-error {
        display: none;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
        font-size: 13px;
        color: #e53935;
        font-weight: 500;
    }

    .gv-fp-field-error.visible {
        display: flex;
    }

    /* Red border on input when error */
    .gv-input-wrap input.gv-input-invalid {
        border-color: #e53935 !important;
        box-shadow: none !important;
    }

    /* Completely suppress all default MVC/jQuery validation output */
    .gv-fp-hidden-validation,
    .gv-fp-hidden-validation * {
        display: none !important;
        visibility: hidden !important;
    }
</style>

@{
    // Server-side summary errors (key "") — e.g. "User does not exist or is not confirmed"
    var summaryErrors = ViewData.ModelState
        .Where(x => x.Key == "")
        .SelectMany(x => x.Value.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();
}

@if (summaryErrors.Any())
{
    @section Banner {
        <div class="gv-banner-wrap">
            <div class="gv-validation-banner" id="gvFpBanner">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0;">
                    <circle cx="10" cy="10" r="9" stroke="#fff" stroke-width="1.8"/>
                    <path d="M10 6v5" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
                    <circle cx="10" cy="14.5" r="0.9" fill="#fff"/>
                </svg>
                <span>@summaryErrors.First()</span>
                <button type="button" onclick="document.getElementById('gvFpBanner').remove()" aria-label="Close">&times;</button>
            </div>
        </div>
    }
}

<!-- Key icon — Reset.svg already contains the full blue rounded-square + key graphic -->
<div class="gv-fp-icon-wrap">
    <img src="@Url.Content("~/images/Reset.svg")" alt="Reset Password Icon" />
</div>

<div class="gv-fp-title">Forgot Password</div>
<div class="gv-fp-subtitle">To reset your password, enter the email address.</div>

@using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()

    <!-- Email -->
    <div class="gv-form-group">
        <label class="gv-fp-email-label" for="Email">Email Address</label>
        <div class="gv-input-wrap">
            <span class="gv-input-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.5 5.833A1.667 1.667 0 0 1 4.167 4.167h11.666A1.667 1.667 0 0 1 17.5 5.833v8.334a1.667 1.667 0 0 1-1.667 1.666H4.167A1.667 1.667 0 0 1 2.5 14.167V5.833Z" stroke="#9CA3AF" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M2.5 6.667 10 11.25l7.5-4.583" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
            @Html.TextBoxFor(m => m.Email, new
            {
                @class = "form-control",
                id = "Email",
                placeholder = "Enter Email address",
                autocomplete = "email"
            })
        </div>

        <!-- Hidden MVC validation anchor — keeps jQuery Unobtrusive Validation wired up,
             but visually suppressed. JS reads from this and routes to our custom UI. -->
        <span id="gvEmailMvcError" class="gv-fp-hidden-validation" data-valmsg-for="Email" data-valmsg-replace="true"></span>

        <!-- UX-style inline error: circle icon + single clean message (client-side format errors only) -->
        <div class="gv-fp-field-error" id="gvEmailError">
            <svg width="15" height="15" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="10" cy="10" r="9" stroke="#e53935" stroke-width="1.8"/>
                <path d="M10 6v5" stroke="#e53935" stroke-width="1.8" stroke-linecap="round"/>
                <circle cx="10" cy="14.5" r="0.9" fill="#e53935"/>
            </svg>
            <span id="gvEmailErrorText">Invalid email address</span>
        </div>
    </div>

    <!-- Verify Email button -->
    <button type="submit" class="gv-btn-primary">Verify Email</button>

    <!-- Back to login -->
    <div>
        <a href="@Url.Action("Login", "Account")" class="gv-back-link">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 12L6 8l4-4" stroke="#374151" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back to login
        </a>
    </div>
}

@section Scripts {
<script>
    $(function () {
        var emailInput = $('#Email');
        var errorDiv   = $('#gvEmailError');
        var errorText  = $('#gvEmailErrorText');

        // Override jQuery Validate's default handler for the Email field.
        // Instead of writing into the hidden MVC span, we drive our own UX error UI.
        var $form = $('form');

        $form.data('validator') && $.extend($form.data('validator').settings, {
            errorPlacement: function (error, element) {
                // Swallow — we handle display ourselves
            },
            highlight: function (element) {
                if (element.id === 'Email') {
                    emailInput.addClass('gv-input-invalid');
                    // Always show the clean UX message for format errors
                    errorText.text('Invalid email address');
                    errorDiv.addClass('visible');
                }
            },
            unhighlight: function (element) {
                if (element.id === 'Email') {
                    emailInput.removeClass('gv-input-invalid');
                    errorDiv.removeClass('visible');
                    errorText.text('');
                }
            }
        });

        // Clear error as user types
        emailInput.on('input', function () {
            emailInput.removeClass('gv-input-invalid');
            errorDiv.removeClass('visible');
            errorText.text('');
        });
    });
</script>
}
