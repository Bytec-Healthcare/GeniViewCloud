@model GeniView.Cloud.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset Password";
}

<style>
    .gv-rp-icon-wrap {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    .gv-rp-icon-wrap img {
        width: 64px;
        height: 64px;
    }

    .gv-rp-title {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
        text-align: center;
        margin-bottom: 8px;
    }

    .gv-rp-subtitle {
        font-size: 15px;
        color: #6b7280;
        text-align: center;
        margin-bottom: 28px;
    }

    .gv-form-group {
        margin-bottom: 18px;
    }

    .gv-rp-field-error {
        display: none;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
        font-size: 13px;
        color: #e53935;
        font-weight: 500;
    }

    .gv-rp-field-error.visible {
        display: flex;
    }

    .gv-input-wrap input.gv-input-invalid {
        border-color: #e53935 !important;
        box-shadow: none !important;
    }
</style>

@{
    var summaryErrors = ViewData.ModelState
        .Where(x => x.Key == "")
        .SelectMany(x => x.Value.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();
}

@if (summaryErrors.Any())
{
    @section Banner {
        <div class="gv-banner-wrap">
            <div class="gv-validation-banner" id="gvRpBanner">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0;">
                    <circle cx="10" cy="10" r="9" stroke="#fff" stroke-width="1.8"/>
                    <path d="M10 6v5" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
                    <circle cx="10" cy="14.5" r="0.9" fill="#fff"/>
                </svg>
                <span>@summaryErrors.First()</span>
                <button type="button" onclick="document.getElementById('gvRpBanner').remove()" aria-label="Close">&times;</button>
            </div>
        </div>
    }
}

<div class="gv-rp-icon-wrap">
    <img src="@Url.Content("~/images/Reset.svg")" alt="Reset Password Icon" />
</div>

<div class="gv-rp-title">Reset Password</div>
<div class="gv-rp-subtitle">Enter your new password below.</div>

@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Code)

    <!-- Email -->
    <div class="gv-form-group">
        <label class="gv-field-label" for="Email">Email Address</label>
        <div class="gv-input-wrap">
            <span class="gv-input-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.5 5.833A1.667 1.667 0 0 1 4.167 4.167h11.666A1.667 1.667 0 0 1 17.5 5.833v8.334a1.667 1.667 0 0 1-1.667 1.666H4.167A1.667 1.667 0 0 1 2.5 14.167V5.833Z" stroke="#9CA3AF" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M2.5 6.667 10 11.25l7.5-4.583" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", id = "Email", placeholder = "Enter Email address", autocomplete = "email" })
        </div>
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
    </div>

    <!-- New Password -->
    <div class="gv-form-group">
        <label class="gv-field-label" for="Password">New Password</label>
        <div class="gv-input-wrap">
            <span class="gv-input-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3.333" y="9.167" width="13.334" height="9.166" rx="1.667" stroke="#9CA3AF" stroke-width="1.5"/>
                    <path d="M6.667 9.167V6.667a3.333 3.333 0 0 1 6.666 0v2.5" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </span>
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", id = "Password", placeholder = "Enter new password", autocomplete = "new-password" })
            <button type="button" class="gv-eye-toggle" id="gvEyeToggle1" aria-label="Toggle password visibility">
                <svg id="gvEyeOpen1" width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.5 10S5 4.167 10 4.167 17.5 10 17.5 10 15 15.833 10 15.833 2.5 10 2.5 10Z" stroke="#9CA3AF" stroke-width="1.5" stroke-linejoin="round"/>
                    <circle cx="10" cy="10" r="2.5" stroke="#9CA3AF" stroke-width="1.5"/>
                </svg>
                <svg id="gvEyeClosed1" width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:none;">
                    <path d="M2.5 10S5 4.167 10 4.167 17.5 10 17.5 10 15 15.833 10 15.833 2.5 10 2.5 10Z" stroke="#9CA3AF" stroke-width="1.5" stroke-linejoin="round"/>
                    <circle cx="10" cy="10" r="2.5" stroke="#9CA3AF" stroke-width="1.5"/>
                    <line x1="3" y1="3" x2="17" y2="17" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </button>
        </div>
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
    </div>

    <!-- Confirm Password -->
    <div class="gv-form-group">
        <label class="gv-field-label" for="ConfirmPassword">Confirm Password</label>
        <div class="gv-input-wrap">
            <span class="gv-input-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3.333" y="9.167" width="13.334" height="9.166" rx="1.667" stroke="#9CA3AF" stroke-width="1.5"/>
                    <path d="M6.667 9.167V6.667a3.333 3.333 0 0 1 6.666 0v2.5" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </span>
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", id = "ConfirmPassword", placeholder = "Confirm new password", autocomplete = "new-password" })
            <button type="button" class="gv-eye-toggle" id="gvEyeToggle2" aria-label="Toggle confirm password visibility">
                <svg id="gvEyeOpen2" width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.5 10S5 4.167 10 4.167 17.5 10 17.5 10 15 15.833 10 15.833 2.5 10 2.5 10Z" stroke="#9CA3AF" stroke-width="1.5" stroke-linejoin="round"/>
                    <circle cx="10" cy="10" r="2.5" stroke="#9CA3AF" stroke-width="1.5"/>
                </svg>
                <svg id="gvEyeClosed2" width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:none;">
                    <path d="M2.5 10S5 4.167 10 4.167 17.5 10 17.5 10 15 15.833 10 15.833 2.5 10 2.5 10Z" stroke="#9CA3AF" stroke-width="1.5" stroke-linejoin="round"/>
                    <circle cx="10" cy="10" r="2.5" stroke="#9CA3AF" stroke-width="1.5"/>
                    <line x1="3" y1="3" x2="17" y2="17" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </button>
        </div>
        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
    </div>

    <button type="submit" class="gv-btn-primary">Reset Password</button>

    <div>
        <a href="@Url.Action("Login", "Account")" class="gv-back-link" style="display:inline-flex;align-items:center;gap:6px;font-size:13px;color:#374151;text-decoration:none;font-weight:500;margin-top:16px;">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 12L6 8l4-4" stroke="#374151" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back to login
        </a>
    </div>
}

@section Scripts {
<script>
    function wireEyeToggle(toggleId, inputId, openId, closedId) {
        document.getElementById(toggleId).addEventListener('click', function () {
            var pwd = document.getElementById(inputId);
            var open = document.getElementById(openId);
            var closed = document.getElementById(closedId);
            if (pwd.type === 'password') {
                pwd.type = 'text';
                open.style.display = 'none';
                closed.style.display = 'block';
            } else {
                pwd.type = 'password';
                open.style.display = 'block';
                closed.style.display = 'none';
            }
        });
    }
    wireEyeToggle('gvEyeToggle1', 'Password', 'gvEyeOpen1', 'gvEyeClosed1');
    wireEyeToggle('gvEyeToggle2', 'ConfirmPassword', 'gvEyeOpen2', 'gvEyeClosed2');
</script>
}
