@{
    ViewBag.Title = "Password Reset";
}

<style>
    .gv-rpc-icon-wrap {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    .gv-rpc-icon-wrap img {
        width: 64px;
        height: 64px;
    }

    .gv-rpc-title {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
        text-align: center;
        margin-bottom: 8px;
    }

    .gv-rpc-message {
        font-size: 15px;
        color: #6b7280;
        text-align: center;
        margin-bottom: 28px;
        line-height: 1.6;
    }
</style>

<div class="gv-rpc-icon-wrap">
    <img src="@Url.Content("~/images/Reset.svg")" alt="Password Reset Icon" />
</div>

<div class="gv-rpc-title">Password Reset</div>
<div class="gv-rpc-message">Your password has been reset successfully.</div>

<a href="@Url.Action("Login", "Account")" class="gv-btn-primary" style="display:flex;align-items:center;justify-content:center;text-decoration:none;">
    Back to Login
</a>
